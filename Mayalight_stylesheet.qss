/*-----Maya Light (2010 style)--------------------------------------------------------------------------------------------------------------------------------------------*/
/* Generated by build_mayalight.py. Edit the palette there rather than this file. */


/*-----QWidget--------------------------------------------------------------------------------------------------------------------------------------------*/
QWidget { background-color: rgb(212,212,212); color: rgb(0,0,0); selection-color: rgb(255,255,255); selection-background-color: rgb(49,106,197); }

QWidget:disabled { color: rgb(120,120,120); }


/*-----QLabel--------------------------------------------------------------------------------------------------------------------------------------------*/
QLabel { background-color: transparent; color: rgb(0,0,0); }

QLabel:disabled { color: rgb(120,120,120); }


/*-----QMenuBar--------------------------------------------------------------------------------------------------------------------------------------------*/
QMenuBar { background-color: rgb(212,212,212); spacing: 2px; }

QMenuBar::item { background-color: transparent; color: rgb(0,0,0); padding: 2px 6px 2px 6px; }

QMenuBar::item:selected { background-color: rgb(49,106,197); color: rgb(255,255,255); }

QMenuBar::item:pressed { background-color: rgb(49,106,197); color: rgb(255,255,255); }


/*-----QMenu--------------------------------------------------------------------------------------------------------------------------------------------*/
QMenu { background-color: rgb(212,212,212); color: rgb(0,0,0); border: 1px solid rgb(110,110,110); }

QMenu::item { background-color: transparent; padding: 3px 20px 3px 20px; }

QMenu::item:selected { background-color: rgb(49,106,197); color: rgb(255,255,255); }

QMenu::item:disabled { color: rgb(120,120,120); }

QMenu::item:disabled:selected { background-color: transparent; color: rgb(120,120,120); }

QMenu::separator { height: 1px; background-color: rgb(150,150,150); margin: 3px 4px 3px 4px; }

QMenu::tearoff { height: 6px; background-color: rgb(190,190,190); border-bottom: 1px solid rgb(150,150,150); }

QMenu::tearoff:selected { background-color: rgb(49,106,197); }

QMenu QLabel, QMenu QWidget { background-color: rgb(212,212,212); color: rgb(0,0,0); }


/*-----QPushButton--------------------------------------------------------------------------------------------------------------------------------------------*/
QPushButton { color: rgb(0,0,0); background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(244,244,244), stop:1 rgb(214,214,214)); border: 1px solid rgb(110,110,110); border-radius: 2px; padding: 1px 6px 1px 6px; }

QPushButton:hover { background-color: rgb(244,244,244); }

QPushButton:pressed { background-color: rgb(184,184,184); }

QPushButton:checked { background-color: rgb(184,184,184); }

QPushButton:default { border: 2px solid rgb(49,106,197); }

QPushButton:disabled { background-color: rgb(212,212,212); color: rgb(120,120,120); border-color: rgb(150,150,150); }

QPushButton:flat { background-color: transparent; border: none; }


/*-----Icon buttons--------------------------------------------------------------------------------------------------------------------------------------------*/
/* Maya's icons are drawn for a dark UI, so icon-only buttons sit on the darker grey. */
QPushButton[objectName^="shelfButton"],
QPushButton[objectName^="iconTextButton"],
QPushButton[objectName^="symbolButton"],
QPushButton[objectName^="symbolCheckBox"],
QPushButton[objectName^="quickLayout"],
QToolButton { background-color: rgb(163,163,163); border: none; border-radius: 2px; padding: 0px; }

QPushButton[objectName^="shelfButton"]:hover,
QPushButton[objectName^="iconTextButton"]:hover,
QPushButton[objectName^="symbolButton"]:hover,
QPushButton[objectName^="symbolCheckBox"]:hover,
QPushButton[objectName^="quickLayout"]:hover,
QToolButton:hover { background-color: rgb(190,190,190); }

QPushButton[objectName^="shelfButton"]:pressed,
QPushButton[objectName^="iconTextButton"]:pressed,
QPushButton[objectName^="symbolButton"]:pressed,
QPushButton[objectName^="symbolCheckBox"]:pressed,
QPushButton[objectName^="quickLayout"]:pressed,
QPushButton[objectName^="shelfButton"]:checked,
QPushButton[objectName^="iconTextButton"]:checked,
QPushButton[objectName^="symbolButton"]:checked,
QPushButton[objectName^="symbolCheckBox"]:checked,
QPushButton[objectName^="quickLayout"]:checked,
QToolButton:pressed,
QToolButton:checked { background-color: rgb(120,120,120); }


/*-----QLineEdit--------------------------------------------------------------------------------------------------------------------------------------------*/
QLineEdit { color: rgb(0,0,0); background-color: rgb(255,255,255); border: 1px solid rgb(150,150,150); border-top-color: rgb(110,110,110); border-left-color: rgb(110,110,110); padding: 0px 2px 0px 2px; }

QLineEdit:focus { border-color: rgb(49,106,197); }

QLineEdit:read-only { background-color: rgb(196,196,196); }

QLineEdit:disabled { color: rgb(120,120,120); background-color: rgb(212,212,212); }


/*-----QSpinBox--------------------------------------------------------------------------------------------------------------------------------------------*/
QSpinBox, QDoubleSpinBox { color: rgb(0,0,0); background-color: rgb(255,255,255); border: 1px solid rgb(150,150,150); border-top-color: rgb(110,110,110); border-left-color: rgb(110,110,110); }

QSpinBox:disabled, QDoubleSpinBox:disabled { color: rgb(120,120,120); background-color: rgb(212,212,212); }


/*-----QComboBox--------------------------------------------------------------------------------------------------------------------------------------------*/
QComboBox { color: rgb(0,0,0); background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(244,244,244), stop:1 rgb(214,214,214)); border: 1px solid rgb(110,110,110); border-radius: 2px; padding-left: 6px; }

QComboBox:on { background-color: rgb(184,184,184); }

QComboBox:disabled { color: rgb(120,120,120); background-color: rgb(212,212,212); border-color: rgb(150,150,150); }

QComboBox QAbstractItemView { color: rgb(0,0,0); background-color: rgb(255,255,255); border: 1px solid rgb(110,110,110); selection-color: rgb(255,255,255); selection-background-color: rgb(49,106,197); }


/*-----QCheckBox--------------------------------------------------------------------------------------------------------------------------------------------*/
QCheckBox { background-color: transparent; color: rgb(0,0,0); }

QCheckBox:disabled { color: rgb(120,120,120); }

QCheckBox::indicator { width: 11px; height: 11px; border: 1px solid rgb(110,110,110); background-color: rgb(255,255,255); }

QCheckBox::indicator:hover { border-color: rgb(49,106,197); }

QCheckBox::indicator:checked { background-color: rgb(49,106,197); border: 3px solid rgb(255,255,255); width: 7px; height: 7px; }

QCheckBox::indicator:indeterminate { background-color: rgb(150,150,150); border: 3px solid rgb(255,255,255); width: 7px; height: 7px; }

QCheckBox::indicator:disabled { background-color: rgb(212,212,212); border-color: rgb(150,150,150); }

QCheckBox::indicator:checked:disabled { background-color: rgb(120,120,120); border: 3px solid rgb(212,212,212); }


/*-----QRadioButton--------------------------------------------------------------------------------------------------------------------------------------------*/
QRadioButton { background-color: transparent; color: rgb(0,0,0); }

QRadioButton:disabled { color: rgb(120,120,120); }

QRadioButton::indicator { width: 11px; height: 11px; border: 1px solid rgb(110,110,110); border-radius: 6px; background-color: rgb(255,255,255); }

QRadioButton::indicator:hover { border-color: rgb(49,106,197); }

QRadioButton::indicator:checked { background-color: rgb(49,106,197); border: 3px solid rgb(255,255,255); border-radius: 6px; width: 7px; height: 7px; }

QRadioButton::indicator:disabled { background-color: rgb(212,212,212); border-color: rgb(150,150,150); }


/*-----QSlider--------------------------------------------------------------------------------------------------------------------------------------------*/
QSlider { background-color: transparent; }

QSlider::groove:horizontal { height: 4px; background-color: rgb(196,196,196); border: 1px solid rgb(110,110,110); }

QSlider::sub-page:horizontal { background-color: rgb(150,150,150); border: 1px solid rgb(110,110,110); }

QSlider::handle:horizontal { width: 7px; margin: -6px 0px -6px 0px; background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(244,244,244), stop:1 rgb(214,214,214)); border: 1px solid rgb(110,110,110); border-radius: 1px; }

QSlider::handle:horizontal:hover { background-color: rgb(244,244,244); border-color: rgb(49,106,197); }

QSlider::handle:horizontal:disabled { background-color: rgb(212,212,212); border-color: rgb(150,150,150); }

QSlider::groove:vertical { width: 4px; background-color: rgb(196,196,196); border: 1px solid rgb(110,110,110); }

QSlider::handle:vertical { height: 7px; margin: 0px -6px 0px -6px; background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(244,244,244), stop:1 rgb(214,214,214)); border: 1px solid rgb(110,110,110); border-radius: 1px; }


/*-----QScrollBar--------------------------------------------------------------------------------------------------------------------------------------------*/
QScrollBar:vertical { border: 0px; background-color: rgb(196,196,196); width: 14px; margin: 0px; }

QScrollBar:horizontal { border: 0px; background-color: rgb(196,196,196); height: 14px; margin: 0px; }

QScrollBar::handle:vertical { min-height: 24px; background-color: rgb(214,214,214); border: 1px solid rgb(110,110,110); margin: 1px; border-radius: 2px; }

QScrollBar::handle:horizontal { min-width: 24px; background-color: rgb(214,214,214); border: 1px solid rgb(110,110,110); margin: 1px; border-radius: 2px; }

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background-color: rgb(244,244,244); }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

QScrollBar::add-page, QScrollBar::sub-page { background-color: transparent; }


/*-----QTabBar--------------------------------------------------------------------------------------------------------------------------------------------*/
QTabBar { background-color: transparent; }

QTabBar::tab { color: rgb(0,0,0); background-color: rgb(190,190,190); border: 1px solid rgb(110,110,110); padding: 3px 9px 3px 9px; border-top-left-radius: 3px; border-top-right-radius: 3px; }

QTabBar::tab:selected { background-color: rgb(212,212,212); border-bottom-color: rgb(212,212,212); }

QTabBar::tab:!selected { margin-top: 2px; }

QTabBar::tab:hover:!selected { background-color: rgb(214,214,214); }

QTabBar::tab:disabled { color: rgb(120,120,120); }


/*-----QTabWidget--------------------------------------------------------------------------------------------------------------------------------------------*/
QTabWidget { border: none; }

QTabWidget::pane { background-color: rgb(212,212,212); border-top: 1px solid rgb(110,110,110); }


/*-----QTreeView / QListView--------------------------------------------------------------------------------------------------------------------------------------------*/
QTreeView, QListView { color: rgb(0,0,0); background-color: rgb(196,196,196); alternate-background-color: rgb(196,196,196); border: 1px solid rgb(150,150,150); }

QTreeView:disabled, QListView:disabled { color: rgb(120,120,120); }

QTreeView::item:hover, QListView::item:hover { background-color: rgb(224,232,246); color: rgb(0,0,0); }

QTreeView::item:selected, QListView::item:selected { background-color: rgb(49,106,197); color: rgb(255,255,255); }

QTreeView::item:disabled, QListView::item:disabled { color: rgb(120,120,120); }


/*-----QTableView--------------------------------------------------------------------------------------------------------------------------------------------*/
QTableView { color: rgb(0,0,0); background-color: rgb(255,255,255); alternate-background-color: rgb(212,212,212); gridline-color: rgb(150,150,150); border: 1px solid rgb(150,150,150); }

QTableView QTableCornerButton::section { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(244,244,244), stop:1 rgb(214,214,214)); border: 1px solid rgb(150,150,150); }


/*-----QHeaderView--------------------------------------------------------------------------------------------------------------------------------------------*/
QHeaderView { background-color: rgb(212,212,212); border: none; }

QHeaderView::section { color: rgb(0,0,0); background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgb(244,244,244), stop:1 rgb(214,214,214)); border: 1px solid rgb(150,150,150); padding: 2px 4px 2px 4px; }


/*-----QPlainTextEdit / QTextEdit--------------------------------------------------------------------------------------------------------------------------------------------*/
QTextEdit { color: rgb(0,0,0); background-color: rgb(255,255,255); border: 1px solid rgb(150,150,150); }

/* Script Editor and command output: left dark on purpose, see palette notes. */
QPlainTextEdit { color: rgb(220,220,220); background-color: rgb(43,43,43); border: 1px solid rgb(110,110,110); selection-color: rgb(255,255,255); selection-background-color: rgb(49,106,197); }

QPlainTextEdit:!editable { background-color: rgb(43,43,43); }


/*-----QGroupBox--------------------------------------------------------------------------------------------------------------------------------------------*/
QGroupBox { background-color: rgb(212,212,212); border: 1px solid rgb(150,150,150); margin-top: 8px; padding-top: 8px; }

QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0px 3px 0px 3px; background-color: rgb(212,212,212); color: rgb(0,0,0); }


/*-----QProgressBar--------------------------------------------------------------------------------------------------------------------------------------------*/
QProgressBar { color: rgb(0,0,0); background-color: rgb(255,255,255); border: 1px solid rgb(110,110,110); text-align: center; }

QProgressBar::chunk { background-color: rgb(49,106,197); }


/*-----QToolTip--------------------------------------------------------------------------------------------------------------------------------------------*/
QToolTip { color: rgb(0,0,0); background-color: rgb(255,255,225); border: 1px solid rgb(0,0,0); padding: 2px; }


/*-----QStatusBar--------------------------------------------------------------------------------------------------------------------------------------------*/
QStatusBar { color: rgb(0,0,0); background-color: rgb(212,212,212); }

QStatusBar::item { border: none; }


/*-----QSplitter--------------------------------------------------------------------------------------------------------------------------------------------*/
QSplitter::handle { background-color: rgb(190,190,190); }

QSplitter::handle:hover { background-color: rgb(49,106,197); }


/*-----QMessageBox / QFileDialog--------------------------------------------------------------------------------------------------------------------------------------------*/
QMessageBox, QFileDialog, QDialog { color: rgb(0,0,0); background-color: rgb(212,212,212); }

QMessageBox QPushButton { min-width: 80px; min-height: 20px; }


/*-----QmayaSeparator--------------------------------------------------------------------------------------------------------------------------------------------*/
QmayaSeparator { background-color: rgb(150,150,150); }


/*-----Icon bars--------------------------------------------------------------------------------------------------------------------------------------------*/
